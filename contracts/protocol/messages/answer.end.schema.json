{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssc.local/protocol/messages/answer.end.schema.json",
  "title": "AnswerEnd",
  "description": "PC -> phone. Final structured answer; replaces the streamed text on the card.",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer_id", "reason", "cues", "not_in_docs"],
  "properties": {
    "answer_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "reason": { "enum": ["done", "cancelled", "error"] },
    "cues": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 80 },
          "expand": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "fact": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_doc": { "type": "string", "minLength": 1, "maxLength": 256 },
    "not_in_docs": { "type": "boolean" }
  }
}
