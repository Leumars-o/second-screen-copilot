{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssc.local/protocol/messages/session.start.schema.json",
  "title": "SessionStart",
  "description": "PC -> phone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "profile_id", "mode"],
  "properties": {
    "session_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "profile_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "mode": { "enum": ["cloud", "local"] }
  }
}
